{
  "schema_version": 5,
  "application_id": "lightweave_receiver",
  "display_name": "LightWeave Receiver",
  "media_types": ["text", "image", "audio"],
  "source_runtime": "lightweave-uno",
  "wire_format": "LWF1",
  "phone_usb": {
    "transport": "arduino-router-monitor",
    "read_method": "mon/read",
    "write_method": "mon/write",
    "boot_service": "arduino-router-serial.service",
    "result_protocol": "LWRX/2",
    "control_protocol": "LWCT/1",
    "roles": ["listen", "cancel", "status", "text", "image", "audio"],
    "maximum_metadata_bytes": 262144,
    "maximum_media_bytes": 16777216,
    "durable_result_outbox": true,
    "runtime_laptop_required": false
  },
  "optical_contract": {
    "sensor_pin": "A0",
    "sensor_threshold": 800,
    "bit_duration_ms": 25,
    "receiver_sampling_interval_us": 24991,
    "bit_order": "msb-first",
    "start_bit": 1,
    "stop_bit": 0,
    "header_bytes": 10,
    "crc_bytes": 2,
    "maximum_payload_bytes": 2048,
    "crc": "CRC-16/CCITT-FALSE"
  },
  "profiles": {
    "0x01": "I64-Q1-B128",
    "0x02": "I128-Q1-B768",
    "0x03": "I256-Q1-B2048",
    "0x10": "A1-E15-S<n>",
    "0x20": "T1-ASCII-B100"
  },
  "text": {
    "maximum_bytes": 100,
    "encoding": "printable ASCII",
    "ai_model": false,
    "output": "txt"
  },
  "audio": {
    "chunk_bytes": 188,
    "maximum_bytes": 940,
    "maximum_samples": 120000,
    "decoder": "CPU layers 0-4 plus strict Adreno Vulkan layers 5-15"
  }
}
