# Optional local path overrides. Copy to .env; never commit the populated file.
LIGHTWEAVE_MODEL_DIR=C:\path\to\lightweave-models
LIGHTWEAVE_IMAGE_WEIGHTS=C:\path\to\bmshj2018-factorized-prior-1.pth.tar
LIGHTWEAVE_AUDIO_WEIGHTS=C:\path\to\encodec_24khz.th
LIGHTWEAVE_ARM64_PYTHON=C:\path\to\python-arm64.exe
LIGHTWEAVE_IMAGE_DECODER_ONNX=C:\path\to\image_decoder_qdq.onnx
LIGHTWEAVE_RAW_IMAGE_DECODER_ONNX=C:\path\to\raw_image_decoder_qdq.onnx
LIGHTWEAVE_RAW_IMAGE_128_DECODER_ONNX=C:\path\to\raw_image_128_decoder_qdq.onnx
LIGHTWEAVE_AUDIO_TAIL_ONNX=C:\path\to\audio_tail_qdq.onnx
LIGHTWEAVE_ENFORCE_OFFLINE=1
